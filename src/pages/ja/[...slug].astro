---
import { getCollection } from 'astro:content';
import MemoryMap from '../../components/MemoryMap.astro';
import PageTitle from '../../components/PageTitle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const writings = await getCollection('writings', ({ data }) => !data.draft && data.locale === 'ja');
const memories = await getCollection('memories', ({ data }) => !data.draft && data.locale === 'ja');
export async function getStaticPaths() {
  return [
    { params: { slug: 'about' }, props: { page: 'about' } },
    { params: { slug: 'work' }, props: { page: 'work' } },
    { params: { slug: 'writing' }, props: { page: 'writing' } },
    { params: { slug: 'memories' }, props: { page: 'memories' } },
  ];
}
const { page } = Astro.props as { page: string };
const mapMemories = memories.map((entry) => ({ id: entry.id, ...entry.data, date: entry.data.date.toISOString(), href: `/ja/memories/${entry.id.replace(/^ja\//, '')}/` }));
const skills = [['AI のためのデータ基盤', 'Python と Polars で、元データをモデル利用可能かつ追跡可能なデータへ変換する、信頼性の高い取り込み・加工パイプラインを構築する。'], ['実用的な ML / LLM プロダクト', '予測モデル、法律文書向けのファインチューニング、LLM 機能を開発し、分析を利用者の体験へつなげる。'], ['本番運用するバックエンド', 'Django サービスと API を設計し、データ・モデル・インターフェースを明確な境界を持つアプリケーションとして統合する。'], ['クラウド運用', 'Docker、AWS Lambda、CloudWatch、CloudFormation でサービスを運用し、実験を保守できるプロダクトへ育てる。']];
const selectedProjects = [['CaseCompass', '判例検索アプリケーション', 'https://github.com/SHONOSUKE100/CaseCompass'], ['Bar Exam with BERT', '司法試験 PDF の構造化と BERT のファインチューニング', 'https://github.com/SHONOSUKE100/Bar_exam_with_BERT'], ['J-Quants Data Platform', '日本の金融データのためのデータプラットフォーム', 'https://github.com/SHONOSUKE100/jquants-data-platform']];
const projects = [['Bar Exam with BERT', '司法試験 PDF の構造化と BERT のファインチューニング', 'https://github.com/SHONOSUKE100/Bar_exam_with_BERT', '/images/projects/barexam.jpg'], ['CaseCompass', '判例検索アプリケーション', 'https://github.com/SHONOSUKE100/CaseCompass', '/images/projects/casecompass.jpg'], ['Kotatsu', 'オープンソースプロジェクト', 'https://github.com/SHONOSUKE100/Kotatsu', '/images/projects/news.jpg'], ['AIagent Plurality', 'AI エージェントプロジェクト', 'https://github.com/SHONOSUKE100/AIagent_Plurality', '/images/projects/pulrality.jpg'], ['J-Quants Data Platform', '日本の金融データのためのプラットフォーム', 'https://github.com/SHONOSUKE100/jquants-data-platform', '/images/projects/finance.jpg']];
---
{page === 'about' && <SiteLayout locale="ja" title="プロフィール — Sho Ikeda"><PageTitle eyebrow="プロフィール" title="sho ikeda" description="よりよいシステムをつくるために、ソフトウェアエンジニアリング、デザイン、AI を学んでいます。" /><section class="shell about-intro"><p class="about-statement">より良いサービスのために、<br /><em>より良いシステムを設計する。</em></p><p>教育系企業のエンジニアとして働きながら、ソフトウェア、データ、AI の接点でエンジニアリングの実践をしています。大学での国際法の学びと機械学習エンジニアのインターン経験を通じて、技術・ルール・デザインが人のためによりよく機能する仕組みを考え、実装しています。</p></section><section class="shell about-history"><div><p class="eyebrow">経歴</p><h2>学びと仕事</h2></div><ol><li><span class="history-marker">01</span><div><h3>中央大学 法学部</h3><p>2022年4月 — 2026年3月。法学・国際法を学び、AI とデータサイエンスにも取り組む。</p></div></li><li><span class="history-marker">02</span><div><h3>ACES, Inc. / 機械学習エンジニア・インターン</h3><p>2024年9月 — 2026年3月。Django、React、データを軸とした機械学習アプリケーションの開発に取り組む。</p></div></li><li><span class="history-marker">03</span><div><h3>UC Davis / 短期留学</h3><p>2025年8月 — 9月。カリフォルニアでの短期留学を通じて、アメリカの文化と壮大な自然に触れた。</p></div></li><li><span class="history-marker">04</span><div><h3>教育系企業 / Engineer</h3><p>2026年4月 — 現在。エンジニアとして勤務。</p></div></li></ol></section><section class="shell capability-section"><div class="section-intro"><p class="eyebrow">できること</p><h2>つくるもの</h2><p>生データから動くサービスまで。AI を役立つものにし、信頼性を保ちながら改善できるようにするための各層を扱います。</p></div><div class="capability-grid">{skills.map(([title, copy], index) => <article class="capability"><span>0{index + 1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></section><section class="shell github-section"><div class="section-intro"><p class="eyebrow">GitHub の制作</p><h2>アイデアをコードへ</h2></div><div class="github-projects">{selectedProjects.map(([title, copy, href]) => <a href={href} target="_blank" rel="noopener noreferrer"><strong>{title}</strong><span>{copy}</span><b>GitHub ↗</b></a>)}</div><a class="button github-button" href="https://github.com/SHONOSUKE100" target="_blank" rel="noopener noreferrer">GitHub を見る</a></section><section class="shell future-section"><p class="eyebrow">これから</p><h2>AI が、よりよい<br /><span>サービスに届くために。</span></h2><p>データ基盤を整えることで、AI モデルがより多くの社会課題に実装され、よりよいサービスを提供できる環境をつくりたいと考えています。信頼できるデータが流れ、モデルが改善され、プロダクトが継続的に価値を届ける。その循環を確かなものにするエンジニアを目指します。</p></section></SiteLayout>}
{page === 'work' && <SiteLayout locale="ja" title="プロジェクト — Sho Ikeda"><PageTitle eyebrow="プロジェクト" title="Projects" description="アイデアをシステムに。" /><section class="shell projects">{projects.map(([title, description, href, image], index) => <article class="project-card"><div class="project-art project-art--image"><img src={image} alt="" /></div><div class="project-copy"><p class="project-number">0{index + 1}</p><h2><a href={href} target="_blank" rel="noopener noreferrer">{title}</a></h2><p>{description}</p><a class="project-link" href={href} target="_blank" rel="noopener noreferrer">GitHub で見る →</a></div></article>)}</section></SiteLayout>}
{page === 'writing' && <SiteLayout locale="ja" title="記事 — Sho Ikeda"><PageTitle eyebrow="記事" title="Notes" description="感じたこと・学んだこと・考えたことについてつらつらと" /><section class="shell article-list">{writings.sort((a,b) => b.data.publishedAt.getTime()-a.data.publishedAt.getTime()).map((post) => <a class="article-row" href={`/ja/writing/${post.id.replace(/^ja\//, '')}/`}><time>{post.data.publishedAt.toLocaleDateString('ja-JP')}</time><h2>{post.data.title}</h2><span class="tags">{post.data.tags.join(' / ')} →</span></a>)}</section></SiteLayout>}
{page === 'memories' && <SiteLayout locale="ja" title="思い出の地図 — Sho Ikeda"><PageTitle eyebrow="思い出" title="Memory Map" description="旅の場所、写真、小さな振り返り。" /><MemoryMap memories={mapMemories} /></SiteLayout>}

---
import ArticlePage from '../../../components/ArticlePage.astro';
import { publishedWritings, slugOf } from '../../../lib/writing';

export async function getStaticPaths() {
  const posts = await publishedWritings('ja');
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props;
---
<ArticlePage post={post} locale="ja" />

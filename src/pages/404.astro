---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found — Sho Ikeda" description="The page you were looking for could not be found.">
  <section class="not-found shell">
    <div class="not-found-copy">
      <p class="eyebrow">404 / Lost route</p>
      <h1>Wrong<br />Turn<span>.</span></h1>
      <p class="lede">This page has wandered off the map. Let’s get you back to somewhere worth exploring.</p>
      <div class="not-found-actions">
        <a class="button" href="/">Back home</a>
        <a href="/memories/">Open Memory Map →</a>
      </div>
    </div>
    <img class="not-found-art" src="/images/profile.png" alt="A white teddy bear" width="1365" height="2048" />
  </section>
</SiteLayout>

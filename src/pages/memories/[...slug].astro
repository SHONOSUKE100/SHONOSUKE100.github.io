---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const memories = await getCollection('memories', ({ data }) => !data.draft && data.locale === 'en');
  return memories.map((memory) => ({ params: { slug: memory.id }, props: { memory } }));
}

const { memory } = Astro.props;
const { Content } = await render(memory);
const date = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long' }).format(memory.data.date);
const galleryId = `gallery-${memory.id.replace(/[^a-z0-9]/gi, '-')}`;
---

<SiteLayout title={`${memory.data.title} — Memory Map — Sho Ikeda`} description={memory.data.summary}>
  <article class="article-content">
    <p class="eyebrow">Memory · {date}</p>
    <h1>{memory.data.title}<span>.</span></h1>
    <p class="lede">{memory.data.summary}</p>
    <p><strong>{memory.data.locationLabel}</strong></p>
    {memory.data.images.length > 0 && <section class="gallery" data-gallery>
      <div class="gallery-heading"><h2>Photos</h2>{memory.data.images.length > 1 && <p>Swipe, scroll, or use the buttons to see all photos.</p>}</div>
      <div id={galleryId} class="gallery-track" aria-label={`${memory.data.title} photo gallery`}>{memory.data.images.map((image) => <figure><img src={image.src} alt={image.alt} /></figure>)}</div>
      {memory.data.images.length > 1 && <div class="gallery-controls" aria-label="Photo gallery controls">
        <button type="button" data-gallery-previous aria-controls={galleryId}>← <span>Previous</span></button>
        <p aria-live="polite"><span data-gallery-current>1</span> / {memory.data.images.length}</p>
        <button type="button" data-gallery-next aria-controls={galleryId}><span>Next</span> →</button>
      </div>}
    </section>}
    <Content />
    <p><a href="/memories/">← Back to Memory Map</a></p>
  </article>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('.gallery-track');
    const slides = Array.from(gallery.querySelectorAll('figure'));
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const current = gallery.querySelector<HTMLElement>('[data-gallery-current]');
    if (!track || slides.length < 2 || !previous || !next || !current) return;

    const updateControls = () => {
      const index = Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
      current.textContent = String(index + 1);
      previous.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    };
    previous.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }));
    track.addEventListener('scroll', updateControls, { passive: true });
    updateControls();
  });
</script>

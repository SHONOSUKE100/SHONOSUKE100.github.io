---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const memories = await getCollection('memories', ({ data }) => !data.draft && data.locale === 'en');
  return memories.map((memory) => ({ params: { slug: memory.id }, props: { memory } }));
}

const { memory } = Astro.props;
const { Content } = await render(memory);
const date = new Intl.DateTimeFormat('en-CA', { dateStyle: 'long' }).format(memory.data.date);
---

<SiteLayout title={`${memory.data.title} — Memory Map — Sho Ikeda`} description={memory.data.summary}>
  <article class="article-content">
    <p class="eyebrow">Memory · {date}</p>
    <h1>{memory.data.title}<span>.</span></h1>
    <p class="lede">{memory.data.summary}</p>
    <p><strong>{memory.data.locationLabel}</strong></p>
    {memory.data.images.length > 0 && <div class="gallery"><div class="gallery-track" aria-label={`${memory.data.title} photo gallery`}>{memory.data.images.map((image) => <figure><img src={image.src} alt={image.alt} /></figure>)}</div></div>}
    <Content />
    <p><a href="/memories/">← Back to Memory Map</a></p>
  </article>
</SiteLayout>

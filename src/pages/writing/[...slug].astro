---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { contentOgImage } from '../../config/seo';
export async function getStaticPaths() { const posts = await getCollection('writings', ({ data }) => !data.draft && data.locale === 'en'); return posts.map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
const japanesePost = (await getCollection('writings')).find((entry) => entry.id === `ja/${post.id}` && !entry.data.draft);
---
<SiteLayout title={`${post.data.title} — Sho Ikeda`} description={post.data.description} ogType="article" ogImage={post.data.ogImage ?? contentOgImage('writing', post.id, 'en')} ogImageAlt={post.data.title} publishedTime={post.data.publishedAt} modifiedTime={post.data.updatedAt} alternates={japanesePost ? [{ href: `/ja/writing/${post.id}/`, locale: 'ja' }] : []}><article class="article-content"><p class="eyebrow">{post.data.category.replace('-', ' ')}</p><h1>{post.data.title}<span>.</span></h1><p class="lede">{post.data.description}</p><Content /></article></SiteLayout>

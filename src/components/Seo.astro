---
import { site } from '../config/site';

interface Alternate {
  href: string;
  locale: 'en' | 'ja';
}

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  locale: 'en' | 'ja';
  publishedTime?: Date;
  modifiedTime?: Date;
  alternates?: Alternate[];
}

const {
  title,
  description,
  image,
  imageAlt = `${site.name} portfolio preview`,
  type = 'website',
  locale,
  publishedTime,
  modifiedTime,
  alternates = [],
} = Astro.props;
const absolute = (value: string) => new URL(value, Astro.site).toString();
const url = absolute(Astro.url.pathname);
const localeCode = locale === 'ja' ? 'ja_JP' : 'en_US';
const xHandle = new URL(site.x).pathname.replace('/', '');
const generatedImage = image.startsWith('/og/');
const imageType = image.endsWith('.jpg') || image.endsWith('.jpeg') ? 'image/jpeg' : image.endsWith('.webp') ? 'image/webp' : 'image/png';
const defaultHref = locale === 'en' ? Astro.url.pathname : alternates.find((alternate) => alternate.locale === 'en')?.href;
const absoluteImage = absolute(image);
---

<link rel="canonical" href={url} />
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={absolute(alternate.href)} />)}
{defaultHref && <link rel="alternate" hreflang="x-default" href={absolute(defaultHref)} />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={localeCode} />
{alternates.map((alternate) => <meta property="og:locale:alternate" content={alternate.locale === 'ja' ? 'ja_JP' : 'en_US'} />)}
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:secure_url" content={absoluteImage} />
<meta property="og:image:type" content={imageType} />
{generatedImage && <meta property="og:image:width" content="1200" />}
{generatedImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={`@${xHandle}`} />
<meta name="twitter:creator" content={`@${xHandle}`} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={imageAlt} />

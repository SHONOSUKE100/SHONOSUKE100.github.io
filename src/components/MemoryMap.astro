---
interface MemoryItem {
  id: string;
  title: string;
  date: string;
  summary: string;
  latitude: number;
  longitude: number;
  locationLabel: string;
  images: { src: string; alt: string }[];
  href: string;
}

const { memories } = Astro.props as { memories: MemoryItem[] };
---

<section class="memory-page shell" aria-label="Memory Map">
  <div id="memory-map" class="map-frame" aria-label="Interactive map of memories" aria-busy="true">
    <p class="map-loading">Loading map…</p>
  </div>
  <section class="memory-fallback" aria-label="Memory list">
    <h2>All memories</h2>
    <ul class="memory-fallback-list">
      {memories.map((memory) => <li><a href={memory.href}><h3>{memory.title}</h3><p>{memory.summary}</p><small>{memory.locationLabel} · {memory.date.slice(0, 10)}</small></a></li>)}
    </ul>
  </section>
</section>

<script id="memory-data" type="application/json" set:html={JSON.stringify(memories)}></script>
<style is:global>@import 'maplibre-gl/dist/maplibre-gl.css';</style>
<script>
  type MemoryItem = {
    title: string; date: string; summary: string;
    latitude: number; longitude: number; locationLabel: string; href: string;
    images: { src: string; alt: string }[];
  };

  const mapElement = document.querySelector<HTMLElement>('#memory-map');
  const dataElement = document.querySelector<HTMLScriptElement>('#memory-data');
  const memories: MemoryItem[] = JSON.parse(dataElement?.textContent ?? '[]');

  function showMapError(message: string) {
    if (!mapElement) return;
    mapElement.setAttribute('aria-busy', 'false');
    mapElement.replaceChildren();
    const error = document.createElement('p');
    error.className = 'map-error';
    error.textContent = message;
    mapElement.append(error);
  }

  if (!mapElement) throw new Error('Map container was not found.');

  try {
    const maplibregl = await import('maplibre-gl');
    const map = new maplibregl.Map({
      container: mapElement,
      // A self-contained raster style avoids style, sprite, and glyph requests
      // that can leave a vector map blank when an external provider is unavailable.
      style: {
        version: 8,
        sources: {
          openstreetmap: {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '© OpenStreetMap contributors',
            maxzoom: 19,
          },
        },
        layers: [{ id: 'openstreetmap', type: 'raster', source: 'openstreetmap' }],
      },
      center: [139.6503, 35.6762],
      zoom: 8.4,
      maxZoom: 19,
      attributionControl: true,
    });

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    const resizeObserver = new ResizeObserver(() => map.resize());
    resizeObserver.observe(mapElement);
    const photoLayer = document.createElement('div');
    photoLayer.className = 'memory-photo-layer';
    map.getCanvasContainer().append(photoLayer);

    function popupContent(memory: MemoryItem) {
      const popup = new maplibregl.Popup({ offset: 20 });
      const content = document.createElement('div');
      const title = document.createElement('strong');
      title.textContent = memory.title;
      const summary = document.createElement('p');
      summary.textContent = memory.summary;
      const link = document.createElement('a');
      link.href = memory.href;
      link.textContent = 'Read note →';
      content.append(title, summary, link);
      popup.setDOMContent(content);
      return popup;
    }

    /* async function createMarkerImage(src: string) {
      const image = new Image();
      image.decoding = 'async';
      image.src = src;
      await image.decode();

      const scale = 2;

      context.moveTo(center - 7, photoSize - 4);
      context.lineTo(center + 7, photoSize - 4);
      context.lineTo(center, photoSize + pointerHeight);
      context.closePath();
      context.fill();
      context.beginPath();
      context.arc(center, center, 31, 0, Math.PI * 2);
      context.fill();
      context.fillStyle = '#f7f1e5';
      context.beginPath();
      context.arc(center, center, 28, 0, Math.PI * 2);
      context.fill();
      context.save();
      context.beginPath();
      context.arc(center, center, 26, 0, Math.PI * 2);
      context.clip();
      const ratio = Math.max(52 / image.naturalWidth, 52 / image.naturalHeight);
      const width = image.naturalWidth * ratio;
      const height = image.naturalHeight * ratio;
      context.drawImage(image, center - width / 2, center - height / 2, width, height);
      context.restore();
      return context.getImageData(0, 0, canvas.width, canvas.height);
    }

    // `load` waits for the raster tiles too. If a tile provider is slow or unavailable,
    // that event may never arrive and would leave the photo layer undisplayed.
    // `style.load` is sufficient for adding our independent GeoJSON/photo layer.
    const addMemoryPhotoLayer = async () => {
      const markerSources = await Promise.all(memories.map(async (memory, index) => {
        const imageId = `memory-photo-${index}`;
        const src = memory.images[0]?.src ?? '/images/hero-art.jpeg';
        try {
          map.addImage(imageId, await createMarkerImage(src), { pixelRatio: 2 });
        } catch (error) {
          console.warn(`Could not load photo for ${memory.title}; using fallback image.`, error);
          map.addImage(imageId, await createMarkerImage('/images/hero-art.jpeg'), { pixelRatio: 2 });
        }
        return {
          type: 'Feature' as const,
          properties: { imageId, memoryIndex: index },
          geometry: { type: 'Point' as const, coordinates: [memory.longitude, memory.latitude] },
        };
      }));

      map.addSource('memory-photos', {
        type: 'geojson',
        data: { type: 'FeatureCollection', features: markerSources },
      });
      map.addLayer({
        id: 'memory-photos',
        type: 'symbol',
        source: 'memory-photos',
        layout: {
          'icon-image': ['get', 'imageId'],
          'icon-anchor': 'bottom',
          'icon-allow-overlap': true,
          'icon-ignore-placement': true,
        },
      });
      map.on('click', 'memory-photos', (event) => {
        const index = Number(event.features?.[0]?.properties?.memoryIndex);
        const memory = memories[index];
        if (memory) popupContent(memory).setLngLat([memory.longitude, memory.latitude]).addTo(map);
      });
      map.on('mouseenter', 'memory-photos', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'memory-photos', () => { map.getCanvas().style.cursor = ''; });
      map.resize();
      mapElement.setAttribute('aria-busy', 'false');
    };
    if (map.isStyleLoaded()) void addMemoryPhotoLayer();
    else map.once('style.load', () => { void addMemoryPhotoLayer(); }); */
    const photoMarkers = memories.map((memory) => {
      const marker = document.createElement('button');
      marker.className = 'photo-marker';
      marker.type = 'button';
      marker.setAttribute('aria-label', `Open ${memory.title}`);
      const thumbnail = document.createElement('img');
      thumbnail.src = memory.images[0]?.src ?? '/images/hero-art.jpeg';
      thumbnail.alt = '';
      marker.append(thumbnail);
      marker.addEventListener('click', () => {
        popupContent(memory).setLngLat([memory.longitude, memory.latitude]).addTo(map);
      });
      photoLayer.append(marker);
      return { memory, marker };
    });
    const positionPhotoMarkers = () => {
      photoMarkers.forEach(({ memory, marker }) => {
        const point = map.project([memory.longitude, memory.latitude]);
        marker.style.left = `${point.x}px`;
        marker.style.top = `${point.y}px`;
      });
    };
    positionPhotoMarkers();
    requestAnimationFrame(positionPhotoMarkers);
    map.on('render', positionPhotoMarkers);
    map.on('moveend', positionPhotoMarkers);
    mapElement.querySelector('.map-loading')?.remove();
    mapElement.setAttribute('aria-busy', 'false');
    map.once('remove', () => resizeObserver.disconnect());
    map.on('error', (event) => {
      console.error('MapLibre error:', event.error);
      if (!map.isStyleLoaded()) showMapError('The map tiles could not be loaded. Please check your connection and try again.');
    });
  } catch (error) {
    console.error('Unable to load MapLibre.', error);
    showMapError('The interactive map could not be loaded. Please try again later.');
  }
</script>
